  "design": {
    "测试集名称": "建筑涂料行业超图(HyperGraph)+LLM 评测测试集",
    "用途": "验证『行业超图+LLM』与『纯LLM』在建筑涂料行业客户真实问题上的回答效果差异",
    "数据基础": "基于约10万份技术文档（原材料TDS/MSDS、建筑涂料配方文档）构建的行业超图",
    "问题总数": "1020 条",
    "提问者身份(5类)": "原材料生产商(技术/销售)、原材料贸易商(采购/销售)、涂料厂技术(配方/研发)、涂料厂采购、涂料厂质检与应用(质检/施工服务)",
    "问题层面(2类)": "原材料（乳液/树脂/颜料/填料/助剂/溶剂/功能材料）；制品（内墙/外墙/弹性/真石漆/质感/多彩/底漆/防水/防火/隔热/无机/艺术涂料）",
    "能力维度(11类)": "单跳事实检索、属性对比、条件筛选、应用匹配、多跳推理、配方分析、问题诊断、选型推荐、成本计算、法规合规、交叉验证",
    "难度等级(4级)": "L1简单（单文档事实检索，0跳）；L2中等（对比/筛选，1跳）；L3较难（多跳推理/诊断，2跳）；L4高难（综合推理/多约束决策，3跳+）",
    "推理跳数": "0跳=单文档直接检索；1跳=单关系链；2跳=跨2层关系推理；3+=多链综合推理/证据交叉",
    "评测方法": "同一组问题分别用【超图+LLM】与【纯LLM】回答，按『预期答案要点』逐项打分对比；建议每类问题抽样≥30条以保证统计显著性",
    "评分方式": "建议0-3分制：0=完全错误/幻觉，1=部分正确，2=基本正确，3=完整正确且推理链清晰；另记录回答用时与证据引用情况",
    "输出结构": "Sheet1=测试集主表（1020题）；Sheet3=分布统计；本Sheet=设计说明",
    "免责声明": "测试集基于行业公开常识与典型配方知识构建，用于评测对比，不构成配方或采购决策依据"
  },
